// Declare 32-byte address keys. A caller can increment only its own counter.
fn call(input: u64) -> u64 {
    let mut slot: u64 = 0;
    while slot < key_count() {
        if key_word(slot, 0) == caller(0)
            && key_word(slot, 1) == caller(1)
            && key_word(slot, 2) == caller(2)
            && key_word(slot, 3) == caller(3) {
            let next: u64 = state_get_at(slot) + input;
            state_set_at(slot, next);
            emit(1, next);
            return next;
        }
        slot = slot + 1;
    }
    return 0;
}
